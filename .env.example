# EnglishMate AI Environment Configuration

# Database (Optional - MongoDB Atlas)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/englishmate?retryWrites=true&w=majority"

# AI Tutor API (Google Gemini API)
GEMINI_API_KEY=""

# NextAuth / Auth.js
NEXTAUTH_SECRET="your-super-secret-jwt-key-replace-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Application Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# AI Speaking Coach Quotas & Limits (Server-enforced)
SPEAKING_COACH_GUEST_LIMIT=5
SPEAKING_COACH_USER_LIMIT=30
SPEAKING_COACH_MAX_AUDIO_SECONDS=45

